---
import Dasar from '../layouts/Dasar.astro';
import Sampul from '../components/Sampul.astro';
import Pembuka from '../components/Pembuka.astro';
import Kutipan from '../components/Kutipan.astro';
import Tentang from '../components/Tentang.astro';
import Bersama from '../components/Bersama.astro';
import Sorotan from '../components/Sorotan.astro';
import Galeri from '../components/Galeri.astro';
import Pesan from '../components/Pesan.astro';
import Penutup from '../components/Penutup.astro';
import Navigasi from '../components/Navigasi.astro';
import AturFoto from '../components/AturFoto.astro';
import { pasangan } from '../data/halaman';

const nama = `${pasangan.pria.panggilan} & ${pasangan.wanita.panggilan}`;
---

<Dasar judul={nama} deskripsi={`Cerita kecil ${nama}.`}>
  <Sampul />
  <main>
    <Pembuka />
    <Kutipan />
    <Tentang />
    <Bersama />
    <Sorotan />
    <Galeri />
    <Pesan />
  </main>
  <Penutup />
  <Navigasi />
  <AturFoto />
</Dasar>

<script>
  import '../scripts/gerak.ts';
</script>
