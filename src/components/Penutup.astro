---
import { Image } from 'astro:assets';
import { foto, pasangan, slot } from '../data/halaman';
---

<footer class="penutup">
  <div class="foto" data-paralaks="0.1">
    <Image src={foto.penutup.src} alt={foto.penutup.alt} data-slot={slot(foto.penutup.src)} widths={[1024]} sizes="100vw" style={`object-position:${foto.penutup.fokus}`} />
  </div>
  <div class="isi">
    <p class="muncul">
      Terima kasih sudah mampir dan ikut membaca cerita kecil kami.
      Semoga harimu juga menyenangkan.
    </p>
    <p class="label muncul" style="--tunda:.1s">Salam hangat</p>
    <p class="nama skrip muncul" style="--tunda:.2s">
      {pasangan.pria.panggilan} <span>&amp;</span> {pasangan.wanita.panggilan}
    </p>
  </div>
  <p class="kredit">Dibuat dengan Astro</p>
</footer>

<style>
  .penutup {
    position: relative;
    min-height: 90svh;
    display: grid;
    place-items: center;
    padding: 120px var(--tepi) 150px;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  .foto {
    position: absolute;
    inset: -10% 0;
    z-index: -1;
  }

  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--putih) 0%, rgb(253 251 247 / 0.7) 35%, rgb(253 251 247 / 0.82) 100%);
  }

  .isi {
    max-width: 640px;
  }

  .isi > p:first-child {
    font-family: var(--serif);
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.6;
    margin: 0 0 40px;
  }

  .nama {
    font-size: clamp(60px, 9vw, 110px);
    margin: 0;
  }

  .nama span {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 0.5em;
    color: var(--emas);
  }

  .kredit {
    position: absolute;
    bottom: 88px;
    left: 0;
    right: 0;
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--redup);
  }
</style>
