---
import { acara, mempelai, tanggalUtama } from '../data/undangan';

// Tautan "simpan ke Google Kalender" memakai acara pertama sampai acara terakhir.
const kompak = (iso: string) => new Date(iso).toISOString().replace(/[-:]|\.\d{3}/g, '');
const kalender = new URL('https://calendar.google.com/calendar/render');
kalender.searchParams.set('action', 'TEMPLATE');
kalender.searchParams.set('text', `Pernikahan ${mempelai.wanita.panggilan} & ${mempelai.pria.panggilan}`);
kalender.searchParams.set('dates', `${kompak(acara[0].mulai)}/${kompak(acara.at(-1)!.selesai)}`);
kalender.searchParams.set('details', acara.map((a) => `${a.nama}: ${a.tempat}, ${a.alamat}`).join('\n'));
kalender.searchParams.set('location', acara[0].alamat);

const satuan = [
  ['hari', 'Hari'],
  ['jam', 'Jam'],
  ['menit', 'Menit'],
  ['detik', 'Detik'],
];
---

<section class="mundur" id="hitung-mundur" data-sasaran={tanggalUtama}>
  <div class="wadah">
    <p class="label muncul">Menuju hari bahagia</p>
    <div class="angka" role="timer" aria-live="off">
      {
        satuan.map(([kunci, label], i) => (
          <div class="kotak muncul" style={`--tunda:${i * 0.08}s`}>
            <span class="nilai" data-satuan={kunci}>00</span>
            <span class="nama">{label}</span>
          </div>
        ))
      }
    </div>
    <p class="selesai" hidden>Hari yang dinanti telah tiba. Terima kasih atas doa restunya.</p>
    <a class="tombol muncul" href={kalender.toString()} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3.5" y="5" width="17" height="15" rx="1.5"></rect>
        <path d="M3.5 10h17M8 3v4M16 3v4"></path>
      </svg>
      Simpan ke kalender
    </a>
  </div>
</section>

<style>
  .mundur {
    padding-block: clamp(70px, 10vw, 120px);
    text-align: center;
    border-block: 1px solid var(--garis);
  }

  .angka {
    display: flex;
    justify-content: center;
    gap: clamp(10px, 3vw, 40px);
    margin: 8px 0 44px;
  }

  .kotak {
    display: grid;
    gap: 6px;
    min-width: clamp(68px, 14vw, 130px);
    padding-block: 12px;
  }

  .kotak + .kotak {
    border-left: 1px solid var(--garis);
  }

  .nilai {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 8vw, 96px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .nama {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--redup);
  }

  .selesai {
    font-family: var(--serif);
    font-size: 24px;
    font-style: italic;
    margin: 0 0 36px;
  }
</style>

<script>
  const bagian = document.getElementById('hitung-mundur')!;
  const sasaran = new Date(bagian.dataset.sasaran!).getTime();
  const sel = Object.fromEntries(
    [...bagian.querySelectorAll<HTMLElement>('[data-satuan]')].map((el) => [el.dataset.satuan!, el]),
  );
  const dua = (n: number) => String(n).padStart(2, '0');

  const perbarui = () => {
    const sisa = Math.max(0, sasaran - Date.now());
    const detik = Math.floor(sisa / 1000);
    sel.hari.textContent = dua(Math.floor(detik / 86400));
    sel.jam.textContent = dua(Math.floor((detik % 86400) / 3600));
    sel.menit.textContent = dua(Math.floor((detik % 3600) / 60));
    sel.detik.textContent = dua(detik % 60);
    if (sisa === 0) {
      bagian.querySelector<HTMLElement>('.selesai')!.hidden = false;
      clearInterval(jam);
    }
  };
  const jam = setInterval(perbarui, 1000);
  perbarui();
</script>
