---
import { Image } from 'astro:assets';
import { foto, mempelai, tanggalUtama } from '../data/undangan';

const tgl = new Date(tanggalUtama);
const bagian = (opsi: Intl.DateTimeFormatOptions) =>
  tgl.toLocaleDateString('id-ID', { ...opsi, timeZone: 'Asia/Jakarta' });
---

<header class="pembuka" id="beranda">
  <div class="kelopak" aria-hidden="true">
    {Array.from({ length: 14 }, (_, i) => <span style={`--i:${i}`}></span>)}
  </div>

  <div class="pembuka-teks">
    <p class="label muncul">Kami akan menikah</p>
    <h2 class="pembuka-nama">
      <span class="skrip muncul" style="--tunda:.1s">{mempelai.wanita.panggilan}</span>
      <span class="dan muncul" style="--tunda:.25s">&amp;</span>
      <span class="skrip muncul" style="--tunda:.4s">{mempelai.pria.panggilan}</span>
    </h2>
    <div class="pembuka-tanggal muncul" style="--tunda:.55s">
      <span>{bagian({ weekday: 'long' })}</span>
      <strong>{bagian({ day: '2-digit' })}</strong>
      <span>{bagian({ month: 'long' })} {bagian({ year: 'numeric' })}</span>
    </div>
  </div>

  <div class="pembuka-foto" data-paralaks="0.12">
    <div class="bingkai tirai">
      <Image
        src={foto.sampul.src}
        alt={foto.sampul.alt}
        widths={[480, 683]}
        sizes="(max-width: 760px) 80vw, 420px"
        loading="eager"
        style={`object-position:${foto.sampul.fokus}`}
      />
    </div>
    <div class="garis-bingkai" aria-hidden="true"></div>
  </div>

  <a class="gulir" href="#kutipan" aria-label="Gulir ke bawah">
    <span></span>
  </a>
</header>

<style>
  .pembuka {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 40px;
    padding: 100px var(--tepi) 80px;
    max-width: 1280px;
    margin-inline: auto;
    overflow: hidden;
  }

  .pembuka-teks {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .pembuka-nama {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    font-weight: 400;
    line-height: 0.95;
  }

  .pembuka-nama .skrip {
    font-size: clamp(76px, 11vw, 150px);
  }

  .pembuka-nama .dan {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(36px, 4vw, 54px);
    color: var(--emas);
    margin: 4px 0 -4px;
  }

  .pembuka-tanggal {
    display: inline-grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 22px;
    margin-top: 40px;
    font-size: 13px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--redup);
  }

  .pembuka-tanggal span:first-child {
    text-align: right;
  }

  .pembuka-tanggal span:last-child {
    text-align: left;
  }

  .pembuka-tanggal strong {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 64px;
    letter-spacing: 0;
    line-height: 1;
    color: var(--tinta);
    padding-inline: 22px;
    border-inline: 1px solid var(--garis);
  }

  .pembuka-foto {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
  }

  .bingkai {
    position: relative;
    z-index: 1;
    aspect-ratio: 3 / 4.3;
    border-radius: var(--lengkung);
  }

  .bingkai img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .garis-bingkai {
    position: absolute;
    inset: -18px 18px 18px -18px;
    border: 1px solid var(--emas-muda);
    border-radius: var(--lengkung);
  }

  .kelopak {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .kelopak span {
    position: absolute;
    top: -40px;
    left: calc(var(--i) * 7.3% + 2%);
    width: 12px;
    height: 16px;
    border-radius: 80% 0 80% 0;
    background: linear-gradient(135deg, #fff, #f1e4d6);
    box-shadow: 0 2px 6px rgb(120 90 50 / 0.12);
    opacity: 0.85;
    animation: jatuh calc(14s + var(--i) * 0.9s) linear infinite;
    animation-delay: calc(var(--i) * -1.7s);
  }

  .kelopak span:nth-child(3n) {
    width: 9px;
    height: 12px;
  }

  @keyframes jatuh {
    0% {
      transform: translate(0, 0) rotate(0);
    }
    50% {
      transform: translate(40px, 55vh) rotate(200deg);
    }
    100% {
      transform: translate(-20px, 115vh) rotate(420deg);
    }
  }

  .gulir {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 1px solid var(--redup);
    border-radius: 20px;
    opacity: 0.6;
  }

  .gulir span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 3px;
    height: 8px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--redup);
    animation: turun 2s ease-in-out infinite;
  }

  @keyframes turun {
    60% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .pembuka {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-top: 72px;
      padding-bottom: 110px;
    }

    .pembuka-foto {
      order: -1;
      width: min(78vw, 340px);
    }

    .pembuka-tanggal {
      gap: 14px;
      font-size: 11px;
    }

    .pembuka-tanggal strong {
      font-size: 48px;
      padding-inline: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kelopak {
      display: none;
    }

    .gulir span {
      animation: none;
    }
  }
</style>
