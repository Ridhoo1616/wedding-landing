---
import { Image } from 'astro:assets';
import { acara, foto } from '../data/undangan';

const zona = { timeZone: 'Asia/Jakarta' } as const;
const hari = (iso: string) =>
  new Date(iso).toLocaleDateString('id-ID', { ...zona, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const jam = (iso: string) =>
  new Date(iso).toLocaleTimeString('id-ID', { ...zona, hour: '2-digit', minute: '2-digit' }).replace('.', ':');
---

<section class="acara bagian" id="acara">
  <div class="latar" data-paralaks="-0.08" aria-hidden="true">
    <Image src={foto.acara.src} alt="" widths={[1024]} sizes="100vw" style={`object-position:${foto.acara.fokus}`} />
  </div>

  <div class="wadah">
    <div class="kepala">
      <p class="label muncul">Waktu &amp; tempat</p>
      <h2 class="judul muncul" style="--tunda:.1s">Rangkaian <em>acara</em></h2>
    </div>

    <div class="daftar">
      {
        acara.map((a, i) => (
          <article class="kartu muncul" style={`--tunda:${0.15 * i}s`}>
            <p class="urutan">{String(i + 1).padStart(2, '0')}</p>
            <h3>{a.nama}</h3>
            <p class="hari">{hari(a.mulai)}</p>
            <p class="jam">
              {jam(a.mulai)} – {jam(a.selesai)} WIB
            </p>
            <div class="garis" />
            <p class="tempat">{a.tempat}</p>
            <p class="alamat">{a.alamat}</p>
            <a class="tombol" href={a.peta} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
                <circle cx="12" cy="9.5" r="2.5" />
              </svg>
              Lihat peta
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .acara {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .latar {
    position: absolute;
    inset: -12% 0;
    z-index: -1;
  }

  .latar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .latar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--putih) 0%, rgb(253 251 247 / 0.86) 30%, rgb(253 251 247 / 0.86) 70%, var(--putih) 100%);
    backdrop-filter: blur(2px);
  }

  .kepala {
    text-align: center;
    margin-bottom: clamp(44px, 6vw, 80px);
  }

  .daftar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(20px, 3vw, 36px);
    max-width: 920px;
    margin-inline: auto;
  }

  .kartu {
    padding: clamp(36px, 5vw, 56px) clamp(24px, 4vw, 44px);
    text-align: center;
    background: rgb(255 255 255 / 0.78);
    border: 1px solid var(--garis);
    border-radius: 220px 220px 6px 6px;
    backdrop-filter: blur(8px);
    transition:
      opacity 1.1s var(--mulus),
      transform 1.1s var(--mulus),
      box-shadow 0.6s var(--mulus);
    transition-delay: var(--tunda, 0s);
  }

  .kartu:hover {
    box-shadow: 0 30px 60px -30px rgb(60 45 25 / 0.25);
  }

  .urutan {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--emas);
  }

  h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 44px);
    margin: 8px 0 14px;
  }

  .hari {
    margin: 0;
    font-weight: 450;
  }

  .jam {
    margin: 0;
    color: var(--redup);
  }

  .garis {
    width: 40px;
    height: 1px;
    margin: 22px auto;
    background: var(--emas);
  }

  .tempat {
    margin: 0;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 500;
  }

  .alamat {
    margin: 4px 0 28px;
    color: var(--redup);
    font-size: 15px;
  }
</style>
