---
import { kutipan } from '../data/halaman';

const kata = kutipan.teks.split(' ');
---

<section class="kutipan bagian" id="kutipan">
  <div class="wadah">
    <div class="hiasan muncul" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M16 4c3 5 3 9 0 12-3-3-3-7 0-12Z"></path>
        <path d="M16 16c5-2 9-1 12 2-4 3-8 2-12-2Z"></path>
        <path d="M16 16c-5-2-9-1-12 2 4 3 8 2 12-2Z"></path>
        <path d="M16 16v12"></path>
      </svg>
    </div>
    <blockquote>
      <p class="kata-kata" data-kata>
        {kata.map((k, i) => <span style={`--k:${i}`}>{k} </span>)}
      </p>
      <footer class="muncul">{kutipan.sumber}</footer>
    </blockquote>
  </div>
</section>

<style>
  .kutipan {
    text-align: center;
    background: var(--kertas);
  }

  blockquote {
    max-width: 820px;
    margin: 32px auto 0;
  }

  .kata-kata {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(24px, 3.2vw, 36px);
    line-height: 1.5;
    margin: 0 0 28px;
  }

  /* Kata menebal satu per satu mengikuti posisi gulir (lihat scripts/gerak.ts). */
  .kata-kata span {
    opacity: 0.16;
    transition: opacity 0.5s ease;
  }

  .kata-kata span.nyala {
    opacity: 1;
  }

  footer {
    font-size: 13px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--emas);
  }

  @media (prefers-reduced-motion: reduce) {
    .kata-kata span {
      opacity: 1;
    }
  }
</style>
